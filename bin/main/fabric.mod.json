{
  "schemaVersion": 1,
  "id": "boardcastmod",
  "version": "${version}",
  "name": "BoardcastMod",
  "description": "Real-time scoreboard CSV export, configurable Scoreboard Overhaul style sidebar (OBS overlay compatible), regex chat capture and timer formatting for Minecraft 1.21.",
  "authors": [
    "RATE"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.rate.boardcastmod.BoardcastModPreLaunch"
    ],
    "client": [
      "com.rate.boardcastmod.BoardcastMod"
    ],
    "modmenu": [
      "com.rate.boardcastmod.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "boardcastmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "~1.21",
    "java": ">=21",
    "cloth-config": ">=15.0.127"
  },
  "suggests": {
    "modmenu": ">=11.0.3",
    "obs_overlay": "*",
    "obs-overlay": "*"
  }
}
